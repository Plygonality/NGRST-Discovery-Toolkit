#ASDF 1.0.0
#ASDF_STANDARD 1.6.0
%YAML 1.1
%TAG ! tag:stsci.edu:asdf/
--- !core/asdf-1.1.0
asdf_library: !core/software-1.0.0 {author: The ASDF Developers, homepage: 'http://github.com/asdf-format/asdf',
  name: asdf, version: 5.4.0}
history:
  extensions:
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/core/extensions/core-1.6.0
    manifest_software: !core/software-1.0.0 {name: asdf_standard, version: 1.5.0}
    software: !core/software-1.0.0 {name: asdf, version: 5.4.0}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/transform/extensions/transform-1.7.0
    manifest_software: !core/software-1.0.0 {name: asdf_transform_schemas, version: 0.6.0}
    software: !core/software-1.0.0 {name: asdf-astropy, version: 0.11.0}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://astropy.org/astropy/extensions/units-1.3.0
    software: !core/software-1.0.0 {name: asdf-astropy, version: 0.11.0}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/astronomy/gwcs/extensions/gwcs-1.4.0
    manifest_software: !core/software-1.0.0 {name: asdf_wcs_schemas, version: 0.5.0}
    software: !core/software-1.0.0 {name: gwcs, version: 1.0.3}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://stsci.edu/datamodels/roman/extensions/datamodels-2.1.0
    manifest_software: !core/software-1.0.0 {name: rad, version: 1.1.0}
    software: !core/software-1.0.0 {name: roman_datamodels, version: 1.1.0}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/astronomy/extensions/astronomy-1.2.0
    manifest_software: !core/software-1.0.0 {name: asdf_standard, version: 1.5.0}
    software: !core/software-1.0.0 {name: asdf-astropy, version: 0.11.0}
roman: !<asdf://stsci.edu/datamodels/roman/tags/wfi_image-2.1.0>
  meta:
    calibration_software_name: RomanCAL
    calibration_software_version: '?'
    coordinates: {reference_frame: ICRS}
    ephemeris: {ephemeris_reference_frame: '?', spatial_x: -999999.0, spatial_y: -999999.0,
      spatial_z: -999999.0, time: -999999.0, type: '?', velocity_x: -999999.0, velocity_y: -999999.0,
      velocity_z: -999999.0}
    exposure:
      data_problem: '?'
      effective_exposure_time: -999999.0
      end_time: !time/time-1.4.0 2020-01-01T00:00:00.000
      engineering_quality: '?'
      exposure_time: -999999.0
      frame_time: -999999.0
      hga_move: false
      ma_table_id: '?'
      ma_table_name: '?'
      ma_table_number: -999999
      nresultants: -999999
      read_pattern: []
      start_time: !time/time-1.4.0 2020-01-01T00:00:00.000
      truncated: false
      type: WFI_IMAGE
    file_date: !time/time-1.4.0 {base_format: datetime, value: '2026-10-04T03:07:44.338'}
    filename: detector_fixture.asdf
    guide_star: {epoch: '?', guide_mode: '?', guide_star_id: '?', guide_window_id: '?',
      window_xstart: -999999, window_xstop: -999999, window_ystart: -999999, window_ystop: -999999}
    instrument: {detector: WFI01, name: WFI, optical_element: F158}
    model_type: ImageModel
    observation: {execution_plan: -999999, exposure: -999999, observation: -999999,
      observation_id: FIXTURE-001, pass: -999999, program: -999999, segment: -999999,
      visit: -999999, visit_file_activity: '?', visit_file_group: -999999, visit_file_sequence: -999999,
      visit_id: '?', wfi_parallel: false}
    origin: STSCI/SOC
    photometry: {conversion_megajanskys: -999999.0, conversion_megajanskys_uncertainty: -999999.0,
      pixel_area: -999999.0}
    pointing: {dec_v1: -999999.0, pa_aperture: -999999.0, pa_v3: -999999.0, pointing_engineering_source: CALCULATED,
      ra_v1: -999999.0, target_aperture: '?', target_dec: -999999.0, target_ra: -999999.0}
    prd_version: '?'
    product_type: '?'
    program: {category: '?', investigator_name: '?', science_category: '?', subcategory: '?',
      title: '?'}
    rcs: {active: false, bank: '1', counts: -999999, electronics: A, led: '?'}
    ref_file:
      apcorr: '?'
      area: '?'
      crds: {context: '?', version: '?'}
      dark: '?'
      darkdecaysignal: '?'
      distortion: '?'
      epsf: '?'
      flat: '?'
      gain: '?'
      integralnonlinearity: '?'
      inverselinearity: '?'
      linearity: '?'
      mask: '?'
      photom: '?'
      readnoise: '?'
      refpix: '?'
      saturation: '?'
    sdf_software_version: '?'
    telescope: ROMAN
    velocity_aberration: {dec_reference: -999999.0, ra_reference: -999999.0, scale_factor: -999999.0}
    visit:
      dither:
        executed_pattern: []
        primary_name: '?'
        subpixel_name: '?'
      internal_target: false
      nexposures: -999999
      start_time: !time/time-1.4.0 2020-01-01T00:00:00.000
      type: '?'
    wcs: !<tag:stsci.edu:gwcs/wcs-1.4.0>
      name: ''
      pixel_shape: null
      steps:
      - !<tag:stsci.edu:gwcs/step-1.3.0>
        frame: !<tag:stsci.edu:gwcs/frame2d-1.2.0>
          axes_names: [x, y]
          axes_order: [0, 1]
          axis_physical_types: ['custom:x', 'custom:y']
          name: detector
          unit: [!unit/unit-1.0.0 pixel, !unit/unit-1.0.0 pixel]
        transform: !transform/compose-1.4.0
          forward:
          - !transform/compose-1.4.0
            forward:
            - !transform/compose-1.4.0
              forward:
              - !transform/concatenate-1.4.0
                forward:
                - !transform/shift-1.4.0
                  inputs: [x]
                  offset: -127.5
                  outputs: [y]
                - !transform/shift-1.4.0
                  inputs: [x]
                  offset: -127.5
                  outputs: [y]
                inputs: [x0, x1]
                outputs: [y0, y1]
              - !transform/concatenate-1.4.0
                forward:
                - !transform/scale-1.4.0
                  factor: -3.0555555555555554e-05
                  inputs: [x]
                  outputs: [y]
                - !transform/scale-1.4.0
                  factor: 3.0555555555555554e-05
                  inputs: [x]
                  outputs: [y]
                inputs: [x0, x1]
                outputs: [y0, y1]
              inputs: [x0, x1]
              outputs: [y0, y1]
            - !transform/gnomonic-1.4.0
              direction: pix2sky
              inputs: [x, y]
              outputs: [phi, theta]
            inputs: [x0, x1]
            outputs: [phi, theta]
          - !transform/rotate3d-1.5.0
            direction: native2celestial
            inputs: [phi_N, theta_N]
            outputs: [alpha_C, delta_C]
            phi: 150.0
            psi: 180.0
            theta: 2.0
          inputs: [x0, x1]
          outputs: [alpha_C, delta_C]
      - !<tag:stsci.edu:gwcs/step-1.3.0>
        frame: !<tag:stsci.edu:gwcs/celestial_frame-1.2.0>
          axes_names: [ra, dec]
          axes_order: [0, 1]
          axis_physical_types: ['custom:ra', 'custom:dec']
          name: icrs
          unit: [!unit/unit-1.0.0 deg, !unit/unit-1.0.0 deg]
        transform: null
    wcsinfo: {aperture_name: WFI01_FULL, dec_ref: -999999.0, ra_ref: -999999.0, roll_ref: -999999.0,
      s_region: '?', v2_ref: -999999.0, v3_ref: -999999.0, v3yangle: -999999.0, vparity: -1}
